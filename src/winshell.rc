#include <winver.h>
1 24 "winshell.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 7,0,0,0
 PRODUCTVERSION 7,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "WinShell Taskbar & Desktop"
      VALUE "ProductName", "WinShell"
      VALUE "FileVersion", "7.0.0.0"
      VALUE "OriginalFilename", "WinShell.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
